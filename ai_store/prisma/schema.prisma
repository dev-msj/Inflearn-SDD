// TECH_SPEC 3장(데이터 모델)의 단일 소스.
//
// ── Prisma로 표현할 수 없어 raw SQL(migrations/0001_init/migration.sql)에만 존재하는 객체 ──
//  1) uq_orders_paid_owner : UNIQUE (user_id, template_id) WHERE status IN ('PAID','REFUND_REQUESTED')
//     ★스키마에 @@unique로 선언하면 (user_id, template_id)가 "전역 유니크"로 잘못 모델링되어
//       FAILED/EXPIRED 이후의 재시도 주문 자체가 막히고 생성 타입까지 오염된다. 의도적으로 제외한다.
//  2) uq_refunds_active    : UNIQUE (order_id) WHERE status IN ('REQUESTED','APPROVED','COMPLETED')
//  3) idx_templates_title_trgm / idx_templates_desc_trgm : GIN (gin_trgm_ops) — 검색 1초 기준(F1-AC3)
//  4) idx_templates_onsale / idx_templates_category / idx_orders_reconcile / idx_orders_expiring
//     : 부분 인덱스(WHERE 절)
//  5) price_krw >= 0 / price_usd >= 0 CHECK 제약
// 위 객체는 Prisma가 인지하지 못하므로 `prisma migrate dev`가 드리프트로 판단할 수 있다.
// 스키마 변경 시에는 새 마이그레이션에 해당 SQL을 다시 포함시킬 것.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enum (TECH_SPEC 5장 도메인 타입과 1:1)
// ─────────────────────────────────────────────────────────────

enum TemplateStatus {
  DRAFT
  ON_SALE
  SUSPENDED
}

enum Currency {
  KRW
  USD
}

enum PaymentProviderId {
  TOSS
  PADDLE
}

enum OrderStatus {
  PENDING
  CONFIRMING
  PAID
  FAILED
  EXPIRED
  REFUND_REQUESTED
  REFUNDED
}

enum ReconcileState {
  NONE
  WATCHING
  INCIDENT
  RESOLVED
}

enum ProviderPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  EXPIRED
  REFUNDED
  UNKNOWN
}

enum LibraryItemStatus {
  ACTIVE
  REVOKED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  SKIPPED
  FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum OrderEventSource {
  WEBHOOK
  BATCH
  REDIRECT
  USER
  SYSTEM
}

enum OutboundEmailType {
  PURCHASE_CONFIRMATION
  RECONCILE_REPORT
}

enum OutboundEmailStatus {
  QUEUED
  SENT
  FAILED
}

// ─────────────────────────────────────────────────────────────
// 계정 (Auth.js Prisma Adapter 표준 + 자체 Credentials 필드)
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// citext: 대소문자 무관 유일. 로그인 시 이메일 정규화 로직에 의존하지 않기 위함
  email         String    @unique @db.Citext
  /// argon2id 해시. 원문 비밀번호는 어떤 경로로도 저장·로깅하지 않는다
  passwordHash  String    @map("password_hash")
  name          String?
  image         String?
  /// 메일 발송 언어 결정('ko' | 'en')
  locale        String    @default("ko")
  /// TECH_SPEC의 email_verified_at 컬럼. Auth.js 어댑터가 기대하는 필드명(emailVerified)에 매핑해
  /// 컬럼명은 스펙을, 필드명은 어댑터 규약을 동시에 만족시킨다. MVP는 미인증 결제 허용(N9)
  emailVerified DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts     Account[]
  sessions     Session[]
  orders       Order[]
  libraryItems LibraryItem[]

  @@map("users")
}

/// Auth.js 표준 스키마. MVP는 소셜 로그인이 없어 사용되지 않으나
/// PrismaAdapter가 런타임에 접근하므로 모델 자체는 유지한다.
model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────
// 카탈로그
// ─────────────────────────────────────────────────────────────

model Category {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String     @unique
  nameKo    String     @map("name_ko")
  nameEn    String     @map("name_en")
  sortOrder Int        @default(0) @map("sort_order")
  templates Template[]

  @@map("categories")
}

model Template {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String @unique
  categoryId  String @map("category_id") @db.Uuid
  title       String
  summary     String
  /// 검색 대상(F1-AC3). pg_trgm GIN 인덱스가 걸린다
  description String
  usageGuide  String @map("usage_guide")
  /// ★프롬프트 전문. 구매 확정자 외 어떤 응답·직렬화 경로에도 포함 금지(F1-AC6).
  ///  공개 조회는 template.repository.ts의 select에서 이 컬럼을 아예 제외한다.
  body        String

  /// buildPreview(body) 결과. 마스킹은 클라이언트 자르기가 아니라 저장된 값 사용(F1-AC5)
  previewText      String @map("preview_text")
  previewCharCount Int    @map("preview_char_count")
  maskedCharCount  Int    @map("masked_char_count")
  thumbnailUrl     String @map("thumbnail_url")

  /// 통화별 개별 고정가(D4). 환산·환율 로직 없음
  priceKrw Int     @map("price_krw")
  priceUsd Decimal @map("price_usd") @db.Decimal(10, 2)

  status        TemplateStatus @default(DRAFT)
  publishedAt   DateTime?      @map("published_at") @db.Timestamptz(6)
  /// ★body가 바뀔 때만 갱신. 가격 수정으로 "마지막 수정일"(F3-AC6)이 흔들리지 않도록 updatedAt과 분리
  bodyUpdatedAt DateTime       @default(now()) @map("body_updated_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// soft delete. 삭제해도 구매자 열람은 보존된다(F1-AC8)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  category     Category      @relation(fields: [categoryId], references: [id])
  orders       Order[]
  libraryItems LibraryItem[]

  @@map("templates")
}

// ─────────────────────────────────────────────────────────────
// 주문 · 결제
// ─────────────────────────────────────────────────────────────

model Order {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// AS-20260810-XXXXXXXX. 사용자 노출·메일 표기·결제사 주문 식별자로 동시에 사용
  orderNo    String @unique(map: "uq_orders_no") @map("order_no")
  userId     String @map("user_id") @db.Uuid
  templateId String @map("template_id") @db.Uuid

  currency Currency
  /// ★결제 화면 표시 금액 스냅샷(F2-AC8). 확정 시 결제사 승인 금액과 이 값을 대조한다
  amount   Decimal           @db.Decimal(12, 2)
  provider PaymentProviderId
  status   OrderStatus       @default(PENDING)

  providerOrderRef  String  @map("provider_order_ref")
  providerPaymentId String? @map("provider_payment_id")

  /// 결제 전 환불 정책 동의 시각(F2-AC12). NOT NULL이므로 미동의 주문은 생성 자체가 불가
  refundPolicyAgreedAt DateTime @map("refund_policy_agreed_at") @db.Timestamptz(6)
  /// created_at + ORDER_EXPIRE_MINUTES(기본 30분) (F2-AC9)
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)

  paidAt     DateTime? @map("paid_at") @db.Timestamptz(6)
  failedAt   DateTime? @map("failed_at") @db.Timestamptz(6)
  expiredAt  DateTime? @map("expired_at") @db.Timestamptz(6)
  refundedAt DateTime? @map("refunded_at") @db.Timestamptz(6)

  failureCode    String? @map("failure_code")
  failureMessage String? @map("failure_message")

  /// 재조회 배치(D5) 상태. INCIDENT는 24시간 초과 미확정 또는 금액 불일치(N7)를 의미
  reconcileState    ReconcileState @default(NONE) @map("reconcile_state")
  reconcileAttempts Int            @default(0) @map("reconcile_attempts")
  lastReconciledAt  DateTime?      @map("last_reconciled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User            @relation(fields: [userId], references: [id])
  template      Template        @relation(fields: [templateId], references: [id])
  payments      Payment[]
  libraryItem   LibraryItem?
  refunds       Refund[]
  events        OrderEvent[]
  webhookEvents WebhookEvent[]
  emails        OutboundEmail[]

  @@index([userId, createdAt(sort: Desc)], map: "idx_orders_user")
  @@map("orders")
}

/// 결제사 조회 API 응답 원본 스냅샷. 확정의 근거 자료로 보존한다.
model Payment {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String                @map("order_id") @db.Uuid
  provider          PaymentProviderId
  providerPaymentId String                @map("provider_payment_id")
  status            ProviderPaymentStatus
  amount            Decimal               @db.Decimal(12, 2)
  currency          Currency
  method            String?
  approvedAt        DateTime?             @map("approved_at") @db.Timestamptz(6)
  /// 카드번호 등 민감 필드는 저장 전에 제거한다(비기능 요구: 카드정보 미보관)
  rawSnapshot       Json                  @map("raw_snapshot")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, providerPaymentId], map: "uq_payments_provider_ref")
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// 지급 · 감사
// ─────────────────────────────────────────────────────────────

model LibraryItem {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String @map("user_id") @db.Uuid
  templateId String @map("template_id") @db.Uuid
  /// 주문 1건당 지급 1건. 중복 웹훅이 동시에 처리돼도 두 번째는 유니크 위반으로 롤백된다(F2-AC6)
  orderId    String @unique(map: "uq_library_order") @map("order_id") @db.Uuid

  status            LibraryItemStatus @default(ACTIVE)
  /// 구매일 = 라이브러리 정렬 기준(F3-AC1)
  grantedAt         DateTime          @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// 환불 자격 판정 근거(F2-AC12). 최초 1회만 기록하고 이후 갱신하지 않는다
  firstViewedAt     DateTime?         @map("first_viewed_at") @db.Timestamptz(6)
  firstDownloadedAt DateTime?         @map("first_downloaded_at") @db.Timestamptz(6)
  revokedAt         DateTime?         @map("revoked_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id])
  template Template @relation(fields: [templateId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  /// 계정당 템플릿 1개 보유 — 중복 지급의 최종 방어선
  @@unique([userId, templateId], map: "uq_library_owner")
  @@index([userId, grantedAt(sort: Desc)], map: "idx_library_user")
  @@map("library_items")
}

/// 멱등성 저장소. UNIQUE(provider, event_id)가 중복 지급 방지의 1차 방어선이다.
model WebhookEvent {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          PaymentProviderId
  eventId           String            @map("event_id")
  eventType         String            @map("event_type")
  signatureVerified Boolean           @map("signature_verified")
  orderId           String?           @map("order_id") @db.Uuid
  status            WebhookStatus     @default(RECEIVED)
  payload           Json
  error             String?
  receivedAt        DateTime          @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt       DateTime?         @map("processed_at") @db.Timestamptz(6)

  order Order? @relation(fields: [orderId], references: [id])

  @@unique([provider, eventId], map: "uq_webhook_event")
  @@map("webhook_events")
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  status           RefundStatus @default(REQUESTED)
  reasonCode       String       @map("reason_code")
  reasonText       String?      @map("reason_text")
  /// 전액 환불만 지원(MVP)
  amount           Decimal      @db.Decimal(12, 2)
  currency         Currency
  providerRefundId String?      @map("provider_refund_id")
  requestedAt      DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt      DateTime?    @map("completed_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@map("refunds")
}

/// 모든 상태 전이의 감사 로그. from/to/source/actor/meta를 남긴다.
model OrderEvent {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String           @map("order_id") @db.Uuid
  fromStatus OrderStatus?     @map("from_status")
  toStatus   OrderStatus      @map("to_status")
  source     OrderEventSource
  actor      String?
  meta       Json?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_events")
}

/// 메일 중복 발송 방지. UNIQUE(type, order_id)로 주문당 1회 발송을 DB가 보장한다(F2-AC4).
/// order_id가 NULL인 RECONCILE_REPORT는 Postgres의 NULL 비교 규칙상 여러 건 허용된다(일별 리포트).
model OutboundEmail {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              OutboundEmailType
  toEmail           String              @map("to_email")
  orderId           String?             @map("order_id") @db.Uuid
  status            OutboundEmailStatus @default(QUEUED)
  providerMessageId String?             @map("provider_message_id")
  error             String?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)

  order Order? @relation(fields: [orderId], references: [id])

  @@unique([type, orderId], map: "uq_outbound_email_order")
  @@map("outbound_emails")
}

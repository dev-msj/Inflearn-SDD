# git_review 환경변수 예시
# 이 파일을 `.env.local`로 복사한 뒤 실제 값으로 채운다. `.env.local`은 커밋하지 않는다.
# 모든 변수는 서버 전용이다. NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 노출되므로 절대 사용하지 않는다.

# GitHub App의 Client ID
# 발급 위치: GitHub > Settings > Developer settings > GitHub Apps > (앱 선택) > General
GITHUB_APP_CLIENT_ID=Iv1.0123456789abcdef

# GitHub App의 Client Secret (code <-> token 교환에만 사용하는 서버 전용 시크릿)
# 절대 클라이언트 코드나 응답 바디에 포함하지 않는다.
GITHUB_APP_CLIENT_SECRET=0123456789abcdef0123456789abcdef01234567

# GitHub App의 slug (설치 안내 링크 https://github.com/apps/{slug}/installations/new 생성용)
# 앱 공개 페이지 URL의 마지막 경로 세그먼트와 동일하다.
GITHUB_APP_SLUG=git-review-app

# iron-session 쿠키 암호화 키 (32자 이상 필수)
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# 애플리케이션 기본 URL. OAuth redirect_uri 구성에 사용한다.
# 후행 슬래시 없이 입력한다. 배포 환경에서는 실제 도메인(https://...)으로 교체한다.
# GitHub App 설정의 "Callback URL"에는 {APP_BASE_URL}/api/auth/callback 을 등록해야 한다.
APP_BASE_URL=http://localhost:3000

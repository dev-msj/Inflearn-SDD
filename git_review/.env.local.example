# git_review 환경변수 예시
# 이 파일을 `.env.local`로 복사한 뒤 실제 값으로 채운다. `.env.local`은 커밋하지 않는다.
# 모든 변수는 서버 전용이다. NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 노출되므로 절대 사용하지 않는다.

# OAuth App의 Client ID
# 발급 위치: GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
GITHUB_OAUTH_CLIENT_ID=Ov23li0123456789abcd

# OAuth App의 Client Secret (code <-> token 교환에만 사용하는 서버 전용 시크릿)
# 절대 클라이언트 코드나 응답 바디에 포함하지 않는다.
GITHUB_OAUTH_CLIENT_SECRET=0123456789abcdef0123456789abcdef01234567

# iron-session 쿠키 암호화 키 (32자 이상 필수)
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# 애플리케이션 기본 URL. OAuth redirect_uri 구성에 사용한다.
# 후행 슬래시 없이 입력한다. 배포 환경에서는 실제 도메인(https://...)으로 교체한다.
# OAuth App 설정의 "Authorization callback URL"에는 {APP_BASE_URL}/api/auth/callback 을 등록해야 한다.
APP_BASE_URL=http://localhost:3000

# 참고: 이 앱은 인가 요청에 scope 파라미터를 보내지 않는다(스코프 없는 사용자 토큰).
# OAuth App의 repo/public_repo 스코프는 읽기와 쓰기가 묶여 있어, 하나라도 요청하면
# "읽기 목적 이외의 저장소 변경은 일어나지 않는다"는 PRD 보안 요구를 보장할 수 없기 때문이다.
# 그 대가로 비공개 저장소는 조회되지 않으며 검증 대상은 공개 저장소로 한정된다.

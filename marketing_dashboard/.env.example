# marketing-dashboard 환경 변수 템플릿
#
# 이 파일을 `.env.local` 로 복사한 뒤 값을 채운다. `.env.local` 은 .gitignore 대상이다.
# 모든 변수는 서버 전용이다. NEXT_PUBLIC_ 접두사를 절대 붙이지 말 것 —
# 접두사를 붙이면 값이 클라이언트 번들에 포함되어 키가 노출된다 (AC-2.7).

# [필수] GitHub OAuth App Client ID
GITHUB_CLIENT_ID=

# [필수] GitHub OAuth App Client Secret
GITHUB_CLIENT_SECRET=

# [필수] OAuth 콜백 URL. 예: http://localhost:3000/api/auth/callback
GITHUB_OAUTH_REDIRECT_URI=

# [필수] iron-session 암호화 키. 32자 이상
SESSION_SECRET=

# [선택] 쉼표 구분 GitHub 로그인 ID 화이트리스트. 비우면 전체 허용(로컬 전용 모드)
ALLOWED_GITHUB_LOGINS=

# [필수] Gemini API 키
GEMINI_API_KEY=

# [선택] 기본값 gemini-flash-latest (현행 flash 모델을 따라가는 별칭)
# 특정 버전 고정이 필요할 때만 채운다. 고정 버전은 은퇴 시 404 로 기능이 멈추므로 주의.
GEMINI_MODEL=
